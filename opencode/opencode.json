{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "more *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "whereis *": "allow",
      "whoami": "allow",
      "id *": "allow",
      "date *": "allow",
      "env *": "allow",
      "printenv *": "allow",
      "du *": "allow",
      "df *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git shortlog *": "allow",
      "git branch --list *": "allow",
      "git branch -a*": "allow",
      "git branch -r*": "allow",
      "git branch -v*": "allow",
      "git branch --show-current": "allow",
      "git remote -v*": "allow",
      "git remote show *": "allow",
      "git remote get-url *": "allow",
      "git tag -l*": "allow",
      "git tag --list*": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git rev-parse *": "allow",
      "git rev-list *": "allow",
      "git describe *": "allow",
      "git blame *": "allow",
      "git grep *": "allow",
      "git merge-base *": "allow",
      "git for-each-ref *": "allow",
      "git submodule status *": "allow",
      "git worktree list *": "allow",
      "git stash list": "allow",
      "git stash show *": "allow",
      "git config --get*": "allow",
      "git config --list*": "allow",
      "git config --show-origin*": "allow",
      "find * -exec *": "ask",
      "find * -execdir *": "ask",
      "find * -delete": "ask",
      "sed -i*": "ask",
      "sed --in-place*": "ask",
      "* > *": "ask",
      "* >> *": "ask"
    }
  }
}
